<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>KometBench</AssemblyName>
    <RootNamespace>KometBench</RootNamespace>
    <Optimize>true</Optimize>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <VsInstall Condition="'$(VsInstall)' == ''">/opt/vintagestory</VsInstall>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Culling/FastCuller.cs" />
    <Compile Include="../Runtime/FarMesh.cs" />
    <Compile Include="../Runtime/FarLod.cs" />
    <Compile Include="../Runtime/ArrayPoolByClass.cs" />
    <Compile Include="../Runtime/JobScheduler.cs" />
    <Compile Include="../Runtime/CpuTopology.cs" />
    <Compile Include="../Culling/CullVerifier.cs" />
    <Compile Include="../Culling/RayTraversal.cs" />
    <Compile Include="../Measure/FrameStats.cs" />
    <Compile Include="../Measure/HitchLog.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VsInstall)/VintagestoryAPI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VsInstall)/Lib/0Harmony.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="cairo-sharp">
      <HintPath>$(VsInstall)/Lib/cairo-sharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SkiaSharp">
      <HintPath>$(VsInstall)/Lib/SkiaSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VsInstall)/Lib/protobuf-net.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VsInstall)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
